{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SCH-16",
  "title": "Copy approval record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "messages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "templates": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "inline": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "pages": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "reviewer": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "decision": {
      "enum": [
        "approved",
        "pending"
      ]
    }
  },
  "required": [
    "messages",
    "templates",
    "pages",
    "reviewer",
    "date",
    "decision"
  ]
}
