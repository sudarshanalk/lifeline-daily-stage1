{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SCH-10",
  "title": "Release record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "release_id": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "tool_hashes": {
      "type": "object",
      "required": [
        "protein",
        "diabetes"
      ],
      "properties": {
        "protein": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diabetes": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "approval_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements_released": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(FR1|NFR1|UI1)-\\d{2}$"
      }
    },
    "backup_id": {
      "type": "string"
    },
    "deploy_command": {
      "type": "string"
    },
    "rollback_command": {
      "type": "string"
    },
    "restore_drill": {
      "type": "object"
    },
    "signoffs": {
      "type": "object"
    }
  },
  "required": [
    "release_id",
    "tag",
    "commit",
    "tool_hashes",
    "approval_ids",
    "evidence_ids",
    "requirements_released",
    "backup_id",
    "deploy_command",
    "rollback_command"
  ]
}
