{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SCH-06e",
  "title": "Evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ev_id": {
      "type": "string",
      "pattern": "^EV-(FR1|NFR1|UI1)-\\d{2}-\\d{8}-\\d{4}$"
    },
    "req_id": {
      "type": "string",
      "pattern": "^(FR1|NFR1|UI1)-\\d{2}$"
    },
    "tc_id": {
      "type": "string"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "tool_hashes": {
      "type": "object",
      "properties": {
        "protein": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "diabetes": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "fixtures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assertion",
          "outcome"
        ],
        "properties": {
          "assertion": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "artefact": {
            "type": "string"
          },
          "oracle": {
            "enum": [
              "characterisation",
              "clinical",
              "none"
            ]
          }
        }
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "red"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "red": {
            "type": "boolean"
          },
          "run": {
            "type": "string"
          }
        }
      }
    },
    "red_run": {
      "type": [
        "string",
        "null"
      ]
    },
    "green_run": {
      "type": "string"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "verdict": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "report": {
          "type": "string"
        }
      }
    },
    "human_gate": {
      "type": [
        "object",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ev_id",
    "req_id",
    "tc_id",
    "commit",
    "tool_hashes",
    "results",
    "green_run",
    "started_at",
    "finished_at"
  ]
}
