{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SCH-02",
  "title": "Tool manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_slug": {
      "type": "string",
      "enum": [
        "protein",
        "diabetes",
        "healthy-weight"
      ]
    },
    "live_url": {
      "type": "string",
      "format": "uri"
    },
    "landing_url": {
      "type": "string",
      "format": "uri"
    },
    "endpoint": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version_hash",
          "captured_at",
          "is_live",
          "engine_hashes"
        ],
        "properties": {
          "version_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "is_live": {
            "type": "boolean"
          },
          "size_bytes": {
            "type": "integer"
          },
          "engine_hashes": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "tool_slug",
    "live_url",
    "landing_url",
    "endpoint",
    "versions"
  ]
}
