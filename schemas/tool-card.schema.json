{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "SCH-04",
  "title": "Tool cards",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "tool_slug",
          "name",
          "purpose",
          "time_minutes",
          "inputs",
          "eligibility",
          "cta_label",
          "landing_url",
          "related_post_id"
        ],
        "properties": {
          "tool_slug": {
            "type": "string",
            "enum": [
              "protein",
              "diabetes"
            ]
          },
          "name": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "maxLength": 120
          },
          "time_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eligibility": {
            "type": "string"
          },
          "cta_label": {
            "type": "string"
          },
          "landing_url": {
            "type": "string"
          },
          "related_post_id": {
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "cards"
  ]
}
