# Managed by deploy/deploy.sh: inserted between "# BEGIN lld" and "# END lld" in the document-root .htaccess.
# Everything outside that block (WordPress, LiteSpeed, Yoast rules) is left untouched.
# __LLD_ORIGIN__ is substituted per environment at deploy time (DEC-34); the Git copy stays environment-neutral.
# Cache-control rules for /tools/* live in site/public_html/tools/.htaccess (FR1-20).
<IfModule mod_headers.c>
  # Security headers (NFR1-03, DEC-35)
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Embed security policy (NFR1-15, DEC-28). The host already emits `Content-Security-Policy: upgrade-insecure-requests`;
  # this second header is additive and both are enforced. The same policy is mirrored as Report-Only so that any
  # violation is observable in browsers and in the e2e suite (TC-NFR1-15-AS-03) without changing enforcement.
  # Landing pages and every other WordPress page: frames may come only from this site and the configured tool origin.
  #
  # C1 staging security checks (9 Nov 2026, owner: "do the CSP"): the same header now carries a full policy, so the
  # site no longer relies on frame-src alone (ZAP: "CSP: Failure to Define Directive with No Fallback"). Sources come
  # from an inventory of every public, member and admin page: Google Tag Manager and Analytics (after consent), Google
  # Fonts, reCAPTCHA on the contact form (www.google.com, www.gstatic.com; its frame was blocked by frame-src before,
  # DEC-54: widened when something breaks), the barcode scanner's blob: worker, Gravatar. 'unsafe-inline' and data:
  # stay in script-src for now: WordPress prints inline scripts and LiteSpeed Cache's JS optimisation turns them into
  # data: scripts; nonces would need both changed (a later step). Forms may post only to this site and on to Stripe
  # Checkout, Google or Apple sign-in. frame-ancestors 'self' matches X-Frame-Options SAMEORIGIN (security.php).
  # wp-admin and wp-login.php get a looser policy (the block editor needs eval, blob: frames and WordPress.org images);
  # SetEnvIf marks those requests. The public policy is set for every request and the admin policy then replaces it
  # where the mark is set: LiteSpeed honours "env=NAME" but not "env=!NAME" (found on staging, 9 Nov 2026), so the
  # public lines carry no condition.
  SetEnvIf Request_URI "^/(wp-admin/|wp-login\.php)" LLD_ADMIN_CSP
  Header always set Content-Security-Policy "frame-src 'self' __LLD_ORIGIN__ https://lifelinedaily.com https://www.google.com; default-src 'self'; script-src 'self' 'unsafe-inline' data: https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://secure.gravatar.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://region1.analytics.google.com https://www.googletagmanager.com; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://accounts.google.com https://appleid.apple.com"
  Header always set Content-Security-Policy-Report-Only "frame-src 'self' __LLD_ORIGIN__ https://lifelinedaily.com https://www.google.com; default-src 'self'; script-src 'self' 'unsafe-inline' data: https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://secure.gravatar.com https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://region1.analytics.google.com https://www.googletagmanager.com; worker-src 'self' blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://checkout.stripe.com https://accounts.google.com https://appleid.apple.com"
  Header always set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-src 'self' __LLD_ORIGIN__ https://lifelinedaily.com https: blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" env=LLD_ADMIN_CSP
  Header always set Content-Security-Policy-Report-Only "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; frame-src 'self' __LLD_ORIGIN__ https://lifelinedaily.com https: blob:; frame-ancestors 'self'; object-src 'none'; base-uri 'self'" env=LLD_ADMIN_CSP
  # Tool pages: may be framed only by our own hosts (the FilesMatch value replaces the page-wide one above).
  <FilesMatch "^(protein-requirement-tool|diabetes-risk-tool|health-tools-hub)\.html$">
    Header always set Content-Security-Policy "frame-ancestors __LLD_ORIGIN__ https://lifelinedaily.com https://www.lifelinedaily.com"
    Header always set Content-Security-Policy-Report-Only "frame-ancestors __LLD_ORIGIN__ https://lifelinedaily.com https://www.lifelinedaily.com"
  </FilesMatch>
</IfModule>
