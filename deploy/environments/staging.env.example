# Staging deploy target (values come from GitHub secrets; this file documents the names only)
DEPLOY_HOST=${STAGING_SSH_HOST}
DEPLOY_PORT=${STAGING_SSH_PORT}
DEPLOY_USER=${STAGING_SSH_USER}
DEPLOY_KEY_FILE=~/.ssh/lld_staging        # written from STAGING_SSH_KEY at job start, chmod 600
DEPLOY_DOCROOT=${STAGING_DOCROOT}          # e.g. /home/<user>/domains/<staging-subdomain>/public_html
DEPLOY_URL=${STAGING_URL}                  # e.g. https://stage1-xxxx.hostingersite.com
DEPLOY_ORIGIN=${STAGING_URL}                 # substituted for __LLD_ORIGIN__ (DEC-34)
