# Repository secrets on GitHub Free; dedicated LLD keys only.
DEPLOY_HOST=${STAGING_SSH_HOST}
DEPLOY_PORT=${STAGING_SSH_PORT}
DEPLOY_USER=${STAGING_SSH_USER}
DEPLOY_KEY_FILE=/absolute/path/to/lld-key
DEPLOY_KNOWN_HOSTS_FILE=/absolute/path/to/verified-known-hosts
DEPLOY_DOCROOT=domains/lifelinedaily.com/public_html/stg
DEPLOY_URL=https://stg.lifelinedaily.com
# Production also requires RELEASE_TAG=rc-... from an approved release.
