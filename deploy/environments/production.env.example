# Production deploy target (values come from the GitHub Environment "production", which requires the release owner's approval)
DEPLOY_HOST=${PROD_SSH_HOST}
DEPLOY_PORT=${PROD_SSH_PORT}
DEPLOY_USER=${PROD_SSH_USER}
DEPLOY_KEY_FILE=~/.ssh/lld_production      # written from PROD_SSH_KEY at job start, chmod 600
DEPLOY_DOCROOT=${PROD_DOCROOT}             # e.g. /home/<user>/domains/lifelinedaily.com/public_html
DEPLOY_URL=https://lifelinedaily.com
RELEASE_TAG=${GITHUB_REF_NAME}             # rc-YYYYMMDD
SHIP_STATUS=0                              # set to 1 only when the release record has ships_status: true
